{
  "version": 1,
  "name": "secret-patterns",
  "description": "Intentional failure covering token patterns and sensitive keys.",
  "tools": {
    "vault.write": { "result": { "ok": true } }
  },
  "cases": [
    {
      "name": "token patterns under a neutral key are redacted",
      "calls": [
        {
          "tool": "vault.write",
          "arguments": {
            "note": "sk-live-FAKEabcdefghijklmnop1234 glpat-FAKEabcdefghijklmnop12 npm_FAKEabcdefghijklmnopqrstuvwxyz123456",
            "callback": "SG.FAKEabcdefghijklmnop.FAKEabcdefghijklmnop",
            "jwt": "eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJkZXYifQ.FAKEsignature12345",
            "aws_secret_access_key": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
            "value": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY",
            "key": "0123456789abcdef0123456789abcdef",
            "pgp": "-----BEGIN PGP PRIVATE KEY BLOCK-----"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.write",
            "arguments": {
              "note": "clean-value",
              "callback": "clean-value",
              "jwt": "clean-value",
              "aws_secret_access_key": "clean-value",
              "value": "clean-value",
              "key": "clean-value",
              "pgp": "clean-value"
            }
          }
        ]
      }
    },
    {
      "name": "AWS secret under a neutral key is redacted",
      "calls": [
        {
          "tool": "vault.write",
          "arguments": {
            "value": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.write",
            "arguments": {
              "value": "clean-value"
            }
          }
        ]
      }
    },
    {
      "name": "32-hex value under a bare key is redacted",
      "calls": [
        {
          "tool": "vault.write",
          "arguments": {
            "key": "0123456789abcdef0123456789abcdef"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.write",
            "arguments": {
              "key": "clean-value"
            }
          }
        ]
      }
    },
    {
      "name": "free-text password claim with filler words is redacted",
      "calls": [
        {
          "tool": "vault.write",
          "arguments": {
            "note": "password used was hunter2"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.write",
            "arguments": {
              "note": "clean-value"
            }
          }
        ]
      }
    },
    {
      "name": "free-text password claim with an adverb is redacted",
      "calls": [
        {
          "tool": "vault.write",
          "arguments": {
            "note": "password is now hunter2"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.write",
            "arguments": {
              "note": "clean-value"
            }
          }
        ]
      }
    }
  ]
}
