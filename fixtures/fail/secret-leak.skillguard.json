{
  "version": 1,
  "name": "secret-leak",
  "description": "Intentional failure used to prove failure output redacts secrets.",
  "tools": {
    "vault.read": { "result": { "ok": true } }
  },
  "cases": [
    {
      "name": "wrong password value",
      "calls": [
        {
          "tool": "vault.read",
          "arguments": {
            "password": "hunter2-super-secret",
            "api_key": "sk-live-abcdefghijklmnop123456"
          }
        }
      ],
      "expect": {
        "calls": [
          {
            "tool": "vault.read",
            "arguments": {
              "password": "other-value",
              "api_key": "sk-other-key-abcdefghijklmnop"
            }
          }
        ]
      }
    }
  ]
}
